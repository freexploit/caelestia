"""Explicit, read-only Plasma capture. See --help before use."""
import os
from pathlib import Path
import sys

sys.dont_write_bytecode = True
sys.path.insert(0, os.environ.get("CAELESTIA_CAPTURE_LIB", str(Path(__file__).resolve().parent.parent / "lib")))
from caelestia_plasma_capture import main

if __name__ == "__main__":
    sys.exit(main())
